[
 {
  "id": "P01",
  "text": "팀장이 회의 때마다 소리를 지르고 막말을 해서 출근이 무서워요.",
  "category": "괴롭힘·안전",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P02",
  "text": "창고 선반이 흔들려서 물건 꺼내다 다칠 뻔했습니다.",
  "category": "괴롭힘·안전",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P03",
  "text": "회식 자리에서 불쾌한 신체 접촉이 있었는데 말할 곳이 없어요.",
  "category": "괴롭힘·안전",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P04",
  "text": "몇 달째 단톡방에서 저만 빼고 이야기해요. 따돌림 같아요.",
  "category": "괴롭힘·안전",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P05",
  "text": "지게차 옆으로 지나다니는 길이 따로 없어서 위험해요.",
  "category": "괴롭힘·안전",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P06",
  "text": "야근이 계속되니 어지럽고 몸이 버티질 못하겠어요.",
  "category": "괴롭힘·안전",
  "sentiment": "불만",
  "note": "업무량과 겹침 — 건강 이상이라 괴롭힘·안전 먼저"
 },
 {
  "id": "P07",
  "text": "상사가 사적인 심부름을 계속 시키고 거절하면 눈치를 줍니다.",
  "category": "괴롭힘·안전",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P08",
  "text": "냉동 창고 문이 안에서 안 열릴 때가 있어 갇힐까 겁나요.",
  "category": "괴롭힘·안전",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P09",
  "text": "요즘은 폭언이 많이 줄어서 그나마 다닐 만해요.",
  "category": "괴롭힘·안전",
  "sentiment": "보통",
  "note": "줄었지만 남아 있음 — 보통"
 },
 {
  "id": "P10",
  "text": "인원은 그대로인데 일이 계속 늘어서 매일 야근해요.",
  "category": "업무량",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P11",
  "text": "납품 철에는 주말에도 나와야 해서 쉬는 날이 없어요.",
  "category": "업무량",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P12",
  "text": "한 사람이 빠지면 그 일이 전부 저한테 몰려요.",
  "category": "업무량",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P13",
  "text": "요즘은 일이 적당해서 정시에 퇴근하고 있어요.",
  "category": "업무량",
  "sentiment": "만족",
  "note": ""
 },
 {
  "id": "P14",
  "text": "서류 작업이 너무 많아서 정작 현장 일을 못 해요.",
  "category": "업무량",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P15",
  "text": "인력 충원이 되고 나서 업무가 한결 나아졌어요.",
  "category": "업무량",
  "sentiment": "만족",
  "note": ""
 },
 {
  "id": "P16",
  "text": "바쁜 달과 한가한 달 차이가 커서 계획 세우기가 어려워요.",
  "category": "업무량",
  "sentiment": "보통",
  "note": ""
 },
 {
  "id": "P17",
  "text": "점심 먹을 시간도 없이 일이 밀려 있어요.",
  "category": "업무량",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P18",
  "text": "업무 분담표가 생겨서 누가 뭘 하는지 분명해졌어요.",
  "category": "업무량",
  "sentiment": "만족",
  "note": ""
 },
 {
  "id": "P19",
  "text": "같은 일을 하는데 급여가 다른 센터보다 적어요.",
  "category": "보상",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P20",
  "text": "야간 수당이 제대로 계산되지 않는 것 같아요.",
  "category": "보상",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P21",
  "text": "연차를 쓰려고 하면 눈치가 보여서 못 써요.",
  "category": "보상",
  "sentiment": "불만",
  "note": "휴가 — 보상"
 },
 {
  "id": "P22",
  "text": "올해 성과급이 나와서 기분이 좋았어요.",
  "category": "보상",
  "sentiment": "만족",
  "note": ""
 },
 {
  "id": "P23",
  "text": "복지 포인트가 생겨서 좋아요.",
  "category": "보상",
  "sentiment": "만족",
  "note": ""
 },
 {
  "id": "P24",
  "text": "월급이 몇 년째 그대로라 생활이 빠듯해요.",
  "category": "보상",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P25",
  "text": "명절 상여금이 줄었는데 이유를 모르겠어요.",
  "category": "보상",
  "sentiment": "불만",
  "note": ""
 },
 {
  "id": "P26",
  "text": "휴가는 자유롭게 쓰는 편이라 괜찮아요.",
  "category": "보상",
  "sentiment": "만족",
  "note": ""
 },
 {
  "id": "P27",
  "text": "급여는 보통인데 교통비 지원이 있으면 좋겠어요.",
